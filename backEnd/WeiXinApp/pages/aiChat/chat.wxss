/* WeiXinApp/pages/aiChat/chat.wxss */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f8fa;
}

.topbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  background: #E95F3C;
  color: #fff;
  padding: 0 16rpx;
  flex-shrink: 0;
}
.topbar-btn {
  font-size: 44rpx;
  padding: 12rpx 24rpx;
  font-weight: bold;
}
.topbar-btn.small { font-size: 32rpx; }
.topbar-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.msg-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 20rpx 40rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }

.bubble {
  max-width: 75%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}
.bubble.user {
  background: #95ec69;
  color: #000;
}
.bubble.assistant {
  background: #fff;
  color: #333;
  border: 1rpx solid #e5e5e5;
}
.bubble.error {
  border-color: #e95f3c;
  color: #e95f3c;
  font-size: 26rpx;
}
.bubble.pending::after {
  content: ' ▍';
  animation: blink 1s infinite;
}
@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  margin-top: 100rpx;
}
.empty .goto-settings {
  color: #E95F3C;
  margin-top: 20rpx;
  display: inline-block;
  border: 1rpx solid #E95F3C;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
}

.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 20rpx;
  background: #fff;
  border-top: 1rpx solid #e5e5e5;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.input-bar textarea {
  flex: 1;
  min-height: 60rpx;
  max-height: 200rpx;
  padding: 16rpx 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1.4;
  box-sizing: border-box;
}
.input-bar .send-btn {
  margin-left: 16rpx;
  background: #E95F3C;
  color: #fff;
  border: none;
  font-size: 30rpx;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}
.input-bar .send-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.drawer-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}
.drawer {
  position: fixed;
  top: 0; left: 0; bottom: 0;
  width: 600rpx;
  background: #fff;
  z-index: 101;
  display: flex;
  flex-direction: column;
}
.drawer-header {
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #eee;
  color: #333;
}
.drawer-list {
  flex: 1;
  overflow-y: auto;
}
.drawer-item {
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.drawer-item.active { background: #fff7f4; }
.drawer-item-title {
  font-size: 30rpx;
  color: #333;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.drawer-item-del {
  color: #e95f3c;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}
.drawer-footer {
  padding: 30rpx;
  border-top: 1rpx solid #eee;
  text-align: center;
  color: #e95f3c;
  font-size: 28rpx;
}
