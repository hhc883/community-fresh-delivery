/* WeiXinApp/pages/aiChat/settings.wxss */
.page {
  padding: 30rpx;
  background: #f7f8fa;
  min-height: 100vh;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.textarea {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  padding: 12rpx 0;
  line-height: 1.5;
}

.picker {
  font-size: 30rpx;
  color: #333;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

.save-btn {
  margin-top: 60rpx;
  background: #E95F3C;
  color: #fff;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.save-btn[disabled] {
  background: #ccc;
  color: #fff;
}
