/* pages/groupon/list.wxss */
.page {
  min-height: 100vh;
  background: #f6f6f6;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 60rpx;
}

.search-btn {
  font-size: 28rpx;
  color: #E95F3C;
  padding-left: 20rpx;
}

/* 我的拼团入口 */
.mine-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 30rpx;
}

.mine-entry .arrow {
  color: #999;
  font-size: 36rpx;
}

/* 提示 */
.tip {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 商品卡片 */
.goods-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.goods-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-meta {
  margin: 10rpx 0;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #E95F3C;
  border: 1rpx solid #f3c0b3;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.price-now {
  color: #E95F3C;
  font-size: 36rpx;
  font-weight: 700;
}

.price-old {
  color: #999;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.groupon-tip {
  font-size: 22rpx;
  color: #E95F3C;
  background: #fdece7;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: auto;
}

.goods-actions {
  display: flex;
  margin-top: 16rpx;
}

.btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  border-radius: 30rpx;
  padding: 12rpx 0;
  margin-left: 16rpx;
}

.btn:first-child {
  margin-left: 0;
}

.btn-plain {
  color: #E95F3C;
  border: 1rpx solid #E95F3C;
  background: #fff;
}

.btn-main {
  color: #fff;
  background: #E95F3C;
}
